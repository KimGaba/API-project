# Postgres
POSTGRES_DB=company_data_dev
POSTGRES_USER=company_data
POSTGRES_PASSWORD=company_data_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://company_data:company_data_dev@postgres:5432/company_data_dev

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# App ports
DASHBOARD_PORT=3012
# Legacy admin app port only. The canonical internal admin/backend/control surface is 3014; keep 3013 only for compatibility while migration is in progress.
ADMIN_PORT=3013

# API
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Billing / auth
# Leave Stripe values blank in local examples; fill them only in your uncommitted .env.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_STARTER_ID=
STRIPE_PRICE_STARTER_MONTHLY_ID=
STRIPE_PRICE_STARTER_YEARLY_ID=
STRIPE_PRODUCT_GROWTH_ID=
STRIPE_PRICE_GROWTH_MONTHLY_ID=
STRIPE_PRICE_GROWTH_YEARLY_ID=
STRIPE_PRODUCT_ENTERPRISE_ID=
BILLING_PROVIDER=stripe
BILLING_WEBHOOK_STORAGE_ENABLED=false
API_KEY_PREFIX=cdp_live

# Ingestion / storage
RAW_ARTIFACTS_DIR=/data/raw-artifacts
DEFAULT_SOURCE_COUNTRIES=GB,NO

# UK live-test helpers (leave blank by default; do not commit real secrets)
COMPANIES_HOUSE_API_KEY=
UK_SOURCE_MODE=fixture
UK_COMPANY_NUMBERS=
WORKER_OUTPUT_DIR=/tmp/company-data-workers

# Search/cache tuning
COMPANY_SEARCH_CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
